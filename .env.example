MONGODB_URI=mongodb://127.0.0.1:27017/student_management
PORT=5001
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=replace-with-a-development-password
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=student_assistant_documents
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=60
REDIS_DISABLED=false
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0